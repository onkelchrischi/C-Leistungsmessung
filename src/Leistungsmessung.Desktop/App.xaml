<Application x:Class="Leistungsmessung.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<SolidColorBrush x:Key="BackgroundBrush" Color="#101827"/>
<SolidColorBrush x:Key="CardBrush" Color="#1C293B"/>
<Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Background" Value="#2978D4"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
<Style TargetType="TabItem">
 <Setter Property="Foreground" Value="#F4F8FF"/>
 <Setter Property="Background" Value="#22344D"/>
 <Setter Property="Margin" Value="2,4,8,4"/>
 <Setter Property="Padding" Value="18,14"/>
 <Setter Property="FontSize" Value="14"/>
 <Setter Property="Template">
  <Setter.Value>
   <ControlTemplate TargetType="TabItem">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1876C7"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#316391"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value>
 </Setter>
</Style>
</Application.Resources>
</Application>
