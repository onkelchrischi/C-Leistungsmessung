<Window x:Class="Leistungsmessung.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Leistungsmessung" WindowState="Maximized" Width="1240" Height="820" MinWidth="900" MinHeight="570"
 Background="{DynamicResource BackgroundBrush}" Foreground="#E6EFFD">
 <Grid Margin="15">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Grid.Row="0" Text="Leistungsmessung" FontSize="23" FontWeight="SemiBold" Margin="4,0,0,10"/>
  <TabControl Grid.Row="1" x:Name="MainTabs" FontSize="14" FontWeight="SemiBold"
       TabStripPlacement="Top" Background="{DynamicResource CardBrush}" BorderThickness="0">
   <TabItem Header="Strom-/Spannungsmessung">
    <Grid Margin="9">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,4,0,10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <TextBlock Text="Messart" Margin="0,0,10,0" VerticalAlignment="Center"/>
       <ComboBox x:Name="MeasurementModePicker" Width="235" SelectionChanged="MeasurementModeChanged">
        <ComboBoxItem Content="Strom/Spannung messen" IsSelected="True"/>
        <ComboBoxItem Content="Sensoren"/>
       </ComboBox>
      </StackPanel>
      <StackPanel x:Name="ElectricalToolbar" Orientation="Horizontal">
       <Button x:Name="StartMeasurementButton" Content="▶ Messung starten" Click="StartMeasurementClick" Width="165"/>
       <Button x:Name="StopMeasurementButton" Content="■ Messung stoppen" Click="StopMeasurementClick" Width="165" IsEnabled="False" Background="#35475F"/>
       <Button Content="Messdatei öffnen" Click="OpenClick" Background="#35475F"/>
       <Button Content="Rohdaten speichern" Click="SaveCaptureClick" Background="#35475F"/>
       <Button Content="Live zurücksetzen" Click="ClearLiveClick" Background="#35475F"/>
      </StackPanel>
      <StackPanel x:Name="SensorToolbar" Orientation="Horizontal" Visibility="Collapsed">
       <TextBlock Text="Aktiver Sensor" VerticalAlignment="Center"/>
       <ComboBox x:Name="SensorPicker" Width="230" DisplayMemberPath="Name" SelectionChanged="SensorSelected"/>
       <Button Content="Sensor hinzufügen" Click="AddSensorClick"/>
       <Button Content="Sensor bearbeiten" Click="EditSensorClick"/>
       <Button Content="Sensor löschen" Click="RemoveSensorClick"/>
       <Button x:Name="SensorStartButton" Content="▶ Messung starten" Click="StartMeasurementClick"/>
       <Button x:Name="SensorStopButton" Content="■ Messung stoppen" Click="StopMeasurementClick" IsEnabled="False"/>
      </StackPanel>
     </StackPanel>
     <Border x:Name="ElectricalValuePanel" Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0"><TextBlock Text="Strom" Foreground="#BDD2EB"/><TextBlock x:Name="CurrentValue" Text="–" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="Spannung" Foreground="#BDD2EB"/><TextBlock x:Name="VoltageValue" Text="–" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Leistung" Foreground="#BDD2EB"/><TextBlock x:Name="PowerValue" Text="–" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/></StackPanel>
       <StackPanel Grid.Column="3"><TextBlock Text="Arbeit" Foreground="#BDD2EB"/><TextBlock x:Name="EnergyValue" Text="–" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/></StackPanel>
      </Grid>
     </Border>
     <Border x:Name="SensorValuePanel" Grid.Row="1" Visibility="Collapsed" Padding="12" Margin="0,0,0,10" Background="#263A54" CornerRadius="8">
      <StackPanel>
       <TextBlock Text="Aktueller Sensorwert" Foreground="#B9D7FB"/>
       <TextBlock x:Name="SensorValueText" Text="–" FontSize="22" FontWeight="Bold" Foreground="White"/>
       <TextBlock x:Name="SensorInfoText" Text="Sensor auswählen" Foreground="#B9D7FB"/>
      </StackPanel>
     </Border>
     <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,0,5">
        <TextBlock x:Name="PlotTitle" FontSize="16" Text="Bereit"/>
        <TextBlock x:Name="PlotDetail" FontSize="11" Foreground="#CDDFF1"/>
        <TextBlock x:Name="LiveStats" FontSize="11" Foreground="#CDDFF1"/>
       </StackPanel>
       <Border Grid.Row="1" Background="#121F30" CornerRadius="8" ClipToBounds="True" SizeChanged="ChartResized">
        <Canvas x:Name="Chart" Background="Transparent" Cursor="Cross" ClipToBounds="True" MouseLeftButtonDown="ChartPanStart" MouseLeftButtonUp="ChartPanEnd" MouseMove="ChartPanMove" MouseWheel="ChartZoomWheel"><Canvas x:Name="ChartGrid" IsHitTestVisible="False"/>
        <Line x:Name="CursorLine" Stroke="#E2E8F0" StrokeThickness="1" StrokeDashArray="3 3" Visibility="Collapsed" IsHitTestVisible="False"/>
        <TextBlock x:Name="CursorReadout" Foreground="White" Background="#C9223348" FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>
        <TextBlock x:Name="CurrentAxisCaption" Text="Strom ←" Foreground="#58C9FA" Canvas.Top="0" Canvas.Left="4"/><TextBlock x:Name="VoltageAxisCaption" Text="→ Spannung" Foreground="#FFA45A" Canvas.Top="0" Canvas.Right="4"/><Path x:Name="Curve" Stroke="#58C9FA" StrokeThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"/><Path x:Name="VoltageCurve" Stroke="#FFA45A" StrokeThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"/><TextBlock x:Name="LeftTopAxis" Text="" Foreground="#58C9FA" Canvas.Left="3" Canvas.Top="19"/>
<TextBlock x:Name="LeftBottomAxis" Text="" Foreground="#58C9FA" Canvas.Left="3" Canvas.Bottom="1"/>
<TextBlock x:Name="RightTopAxis" Text="" Foreground="#FFA45A" Canvas.Right="3" Canvas.Top="19"/>
<TextBlock x:Name="RightBottomAxis" Text="" Foreground="#FFA45A" Canvas.Right="3" Canvas.Bottom="1"/>
<TextBlock x:Name="EmptyMessage" Text="Datei öffnen, um die Messkurve anzuzeigen" Foreground="#C1D4E7" FontSize="16" Canvas.Left="30" Canvas.Top="30"/></Canvas>
       </Border>
      </Grid>
     </Border>
     <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      
      <Border Grid.Column="1" Background="#172437" CornerRadius="6" Height="39" Margin="8,2" Padding="4">
       <Grid>
        <Canvas x:Name="OverviewCanvas" Background="Transparent" MouseLeftButtonDown="OverviewMouseDown" MouseMove="OverviewMouseMove" MouseLeftButtonUp="OverviewMouseUp" SizeChanged="OverviewResized">
         <Path x:Name="OverviewTrace" Stroke="#60C8F7" StrokeThickness="1" IsHitTestVisible="False"/>
         <Rectangle x:Name="OverviewSelection" Width="80" Height="29" Fill="#334A6987" Stroke="#69CBFA" StrokeThickness="1.5" RadiusX="3" RadiusY="3" IsHitTestVisible="False"/>
        </Canvas>
        <TextBlock x:Name="OverviewDescription" Text="Gesamtübersicht · Fenster 5 s" FontSize="11" Foreground="#F0F7FF" Margin="8,9" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Kalibrierung" Visibility="Collapsed">
    <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
     <TextBlock Text="Kalibrierung des AD7765 Boards" FontSize="18" Margin="0,0,0,12"/>
     <TextBlock Text="Geführter Ablauf: Hardware prüfen, Bereiche wählen, je 1.000 ADC-Messwerte pro Referenzpunkt aufnehmen, prüfen und nach Bestätigung gerätespezifisch speichern." TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button Content="Kalibrierung durchführen…" Click="CalibrationWizardClick" HorizontalAlignment="Left"/>
     <Button Content="Kalibrierprofil laden…" Click="LoadCalibrationClick" HorizontalAlignment="Left" Background="#35475F"/>
     <TextBlock x:Name="CalibrationStatus" Text="Kein Kalibrierprofil geladen" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="Einstellungen">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#14243A" CornerRadius="8" Margin="0,0,12,0" Padding="14">
      <StackPanel>
       <TextBlock Text="Einstellungen" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>
       <Button Content="Kalibrierung" Tag="0" Click="SettingsSectionClick" Margin="0,4" HorizontalContentAlignment="Left" Background="#263A54" Foreground="White"/>
       <Button Content="Messgerät" Tag="1" Click="SettingsSectionClick" Margin="0,4" HorizontalContentAlignment="Left" Background="#263A54" Foreground="White"/>
       <Button Content="Darstellung" Tag="2" Click="SettingsSectionClick" Margin="0,4" HorizontalContentAlignment="Left" Background="#263A54" Foreground="White"/>
       <Button Content="Achsen &amp; Einheiten" Tag="3" Click="SettingsSectionClick" Margin="0,4" HorizontalContentAlignment="Left" Background="#263A54" Foreground="White"/>
       <Button Content="Debug" Tag="4" Click="SettingsSectionClick" Margin="0,4" HorizontalContentAlignment="Left" Background="#263A54" Foreground="White"/>
      </StackPanel>
     </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="20">
      <Border x:Name="CalibrationSettingsPanel" Background="#263A54" Padding="16" CornerRadius="8" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="Kalibrierung" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <WrapPanel>
         <Button Content="Kalibrierassistent…" Click="CalibrationWizardClick"/>
         <Button Content="Profil laden…" Click="LoadCalibrationClick"/>
        </WrapPanel>
        <TextBlock Text="PMPP_DEV2: Strom 1 = 10–2500 mA · Strom 2 = 0–10 mA" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <StackPanel x:Name="DeviceSettingsPanel" Visibility="Collapsed"><TextBlock Text="Messgerät" FontSize="18" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal">
       <ComboBox x:Name="FtdiDevices" Width="340" Foreground="#121F30"/>
       <Button Content="Geräte suchen" Click="FtdiScanClick"/>
      </StackPanel>
      <TextBlock x:Name="FtdiStatus" Margin="0,6,0,18" TextWrapping="Wrap"/>
      </StackPanel><StackPanel x:Name="AppearanceSettingsPanel" Visibility="Collapsed"><TextBlock Text="Darstellung" FontSize="18" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Farbprofil" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ComboBox x:Name="ThemeChoice" Width="145" SelectionChanged="ThemeChanged">
          <ComboBoxItem Content="Dunkel" IsSelected="True"/><ComboBoxItem Content="Hell"/>
        </ComboBox>
      </StackPanel>
      </StackPanel><StackPanel x:Name="AxesSettingsPanel" Visibility="Collapsed"><TextBlock Text="Anzeige" FontSize="18" Margin="0,0,0,10"/>
      <WrapPanel>
       <TextBlock Text="Fenster (s)" VerticalAlignment="Center"/><TextBox x:Name="WindowSeconds" Width="60" Text="5" Margin="6,0,16,8"/>
       <TextBlock Text="Frequenz (Hz)" VerticalAlignment="Center"/><TextBox x:Name="DisplayRate" Width="65" Text="50" Margin="6,0,16,8"/>
       <CheckBox x:Name="FixedAxes" Content="Feste Y-Achsen" Margin="0,0,14,8"/>
       <TextBlock Text="Strom-Einheit" VerticalAlignment="Center"/>
       <ComboBox x:Name="CurrentUnit" Width="75" Margin="6,0,16,8" Foreground="#121F30"><ComboBoxItem Content="mA" IsSelected="True"/><ComboBoxItem Content="µA"/></ComboBox>
       <TextBlock Text="Spannungs-Einheit" VerticalAlignment="Center"/>
       <ComboBox x:Name="VoltageUnit" Width="75" Margin="6,0,16,8" Foreground="#121F30"><ComboBoxItem Content="V" IsSelected="True"/><ComboBoxItem Content="mV"/></ComboBox>
      </WrapPanel>
      <WrapPanel>
       <TextBlock Text="I min / max" VerticalAlignment="Center"/><TextBox x:Name="CurrentMin" Width="90" Text="0" Margin="6,0"/>
       <TextBox x:Name="CurrentMax" Width="90" Text="100" Margin="0,0,15,0"/>
       <TextBlock Text="U min / max" VerticalAlignment="Center"/><TextBox x:Name="VoltageMin" Width="90" Text="0" Margin="6,0"/>
       <TextBox x:Name="VoltageMax" Width="90" Text="5"/>
       <Button Content="Einstellungen übernehmen" Click="ApplyDisplaySettingsClick"/>
      </WrapPanel>
      </StackPanel><StackPanel x:Name="DebugSettingsPanel" Visibility="Collapsed"><Separator Margin="0,20,0,14"/>
      <TextBlock Text="Debug / Gerätestatus" FontSize="18" Margin="0,0,0,10"/>
      <TextBlock x:Name="DecodeStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="MonitorStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <CheckBox x:Name="DecodeBoardCheck" IsChecked="True" Visibility="Collapsed"/>
      <CheckBox x:Name="DecodeEvalCheck" IsChecked="False" Visibility="Collapsed"/>
      <Button x:Name="MonitorStartButton" Click="MonitorStartClick" Visibility="Collapsed"/>
     </StackPanel>
     </StackPanel>
    </ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#182337" Padding="8" CornerRadius="6" Margin="0,8,0,0">
   <TextBlock x:Name="Status" FontSize="11" Text="Bereit · AD7765 Board"/>
  </Border>
 </Grid>
</Window>